---
import { REPO, REPO_URL } from '@/lib/seo';
---
<section class="section open" aria-labelledby="open-title">
  <div class="wrap grid">
    <div data-reveal>
      <p class="eyebrow">In the open</p>
      <h2 id="open-title" class="title">Source-available, built in public. <span class="dim">Read the code, build it yourself, tell us what is missing.</span></h2>
      <p class="prose-muted mt-5">Gantry is licensed under the Functional Source License: you can read, run, modify and share it, and each release becomes Apache 2.0 two years on. Development happens in one repository with the plan documents beside the code.</p>
      <div class="links"><a class="arrow-link" href="/changelog/">Changelog</a><a class="arrow-link" href="/about/">Roadmap and status</a><a class="arrow-link" href="/license/">The licence, in plain words</a></div>
    </div>
    <a class="repo card card-hover" href={REPO_URL} rel="noopener" data-reveal style="--reveal-delay: 80ms">
      <span class="repo-top">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        <span class="repo-name">{REPO}</span>
      </span>
      <span class="repo-desc">A desktop AI workspace: chat client, coding agent and connectors. Rust, Tauri, React.</span>
      <span class="repo-meta"><span>★ <b data-stars>—</b></span><span>FSL-1.1-ALv2</span><span data-release-version>No release yet</span></span>
    </a>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .links { display: flex; flex-wrap: wrap; gap: 1.25rem 1.75rem; margin-top: 1.5rem; }
  .repo { display: grid; gap: 0.8rem; padding: 1.5rem; }
  .repo-top { display: flex; align-items: center; gap: 0.7rem; color: var(--color-fg); }
  .repo-name { font-family: var(--font-mono); font-size: 0.95rem; }
  .repo-desc { color: var(--color-fg-2); font-size: 0.95rem; }
  .repo-meta { display: flex; flex-wrap: wrap; gap: 1rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-fg-3); padding-top: 0.8rem; border-top: 1px solid var(--color-line); }
  .repo-meta b { color: var(--color-fg); font-weight: 500; }
  @media (max-width: 52rem) { .grid { grid-template-columns: 1fr; } }
</style>

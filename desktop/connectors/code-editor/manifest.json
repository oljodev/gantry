{
  "manifest_version": "1",
  "id": "code-editor",
  "name": "Code editor",
  "description": "Precise, reviewable edits to source files: replace, insert, patch and undo.",
  "version": "0.1.0",
  "icon": "icon.svg",
  "category": "local",
  "keywords": ["edit", "refactor", "patch", "diff", "code"],
  "publisher": {
    "name": "Gantry",
    "url": "https://gantry.oljo.dev"
  },
  "first_party": true,
  "homepage": "https://gantry.oljo.dev/connectors/code-editor/",
  "license": "FSL-1.1-ALv2",
  "runtime": {
    "kind": "native",
    "crate": "gantry-connector-code-editor",
    "singleton": true
  },
  "auth": {
    "type": "none"
  },
  "risk": {
    "network": "none",
    "local_system": "write",
    "default_tool_tier": "write",
    "notes": "Changes only files inside the folders attached to a chat. Every change is recorded and can be reverted, and it never runs anything."
  },
  "tools_generated": true,
  "catalog": {
    "suggest_for": ["edit", "refactor", "fix", "patch", "source file"],
    "sort_weight": 129
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "gantry": ">=0.1.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gantry.oljo.dev/schemas/connector-manifest.schema.json",
  "title": "Gantry connector manifest",
  "description": "connectors/<id>/manifest.json. Field reference: docs/plan/03-connector-system.md \u00a73.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "name",
    "description",
    "version",
    "icon",
    "category",
    "publisher",
    "runtime",
    "auth",
    "risk"
  ],
  "properties": {
    "manifest_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$",
      "description": "Folder name, tool namespace prefix, catalog key. Immutable."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "long_description": {
      "type": "string",
      "description": "Markdown for the detail page."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "icon": {
      "type": "string",
      "description": "Path relative to the connector folder."
    },
    "category": {
      "enum": [
        "local",
        "developer",
        "productivity",
        "media",
        "data",
        "communication",
        "web",
        "gantry"
      ]
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "first_party": {
      "type": "boolean",
      "default": false
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "documentation": {
      "type": "string",
      "format": "uri"
    },
    "privacy_policy": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "auth": {
      "$ref": "#/$defs/auth"
    },
    "auth_alternate": {
      "$ref": "#/$defs/auth",
      "description": "A second accepted authentication, offered beside `auth` in the install dialog. Use it for servers that take either an OAuth sign-in or a pasted token (docs/plan/03 \u00a77)."
    },
    "user_config": {
      "type": "object",
      "description": "Keys the user fills in at install; MCPB-compatible. Referenced as ${user_config.KEY} in runtime strings.",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/userConfigField"
      }
    },
    "settings_ui": {
      "type": "string",
      "description": "Custom panel entry, e.g. ui/index.tsx."
    },
    "multi_instance": {
      "type": "boolean",
      "default": false
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "tools_generated": {
      "type": "boolean",
      "default": false
    },
    "tool_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "risk": {
            "$ref": "#/$defs/tier"
          },
          "always_confirm": {
            "type": "boolean"
          },
          "parallel_safe": {
            "type": "boolean"
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system_addendum": {
          "type": "string"
        },
        "usage_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "enum": ["darwin", "win32", "linux"]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "gantry": {
          "type": "string",
          "description": "A semver range, e.g. >=0.1.0"
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "featured": {
          "type": "boolean"
        },
        "sort_weight": {
          "type": "number"
        },
        "suggest_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "install_by_default": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "tier": {
      "description": "Risk tier (docs/plan/04-permissions.md \u00a71).",
      "enum": ["read", "write", "write_external", "execute", "destructive", "app"]
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "crate"],
          "properties": {
            "kind": {
              "const": "native"
            },
            "crate": {
              "type": "string",
              "pattern": "^gantry-[a-z0-9-]+$",
              "description": "The crate the code lives in. Usually gantry-connector-<id>; sub agents are in gantry-agent, because running one is running a turn."
            },
            "singleton": {
              "type": "boolean",
              "default": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": {
              "const": "mcp-stdio"
            },
            "command": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "cwd": {
              "type": "string"
            },
            "requires": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "node": {
                  "type": "string"
                },
                "python": {
                  "type": "string"
                },
                "uv": {
                  "type": "string"
                },
                "docker": {
                  "type": "string"
                }
              }
            },
            "platform_overrides": {
              "type": "object",
              "propertyNames": {
                "enum": ["darwin", "win32", "linux"]
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": {
              "const": "mcp-remote"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "transport": {
              "enum": ["streamable-http"],
              "default": "streamable-http"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "inject"],
          "properties": {
            "type": {
              "const": "api_key"
            },
            "inject": {
              "$ref": "#/$defs/inject"
            },
            "instructions": {
              "type": "string"
            },
            "setup_url": {
              "type": "string",
              "format": "uri",
              "description": "The page where the user creates this credential, opened by a button in the install dialog. Query parameters that prefill the form are welcome."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "fields"],
          "properties": {
            "type": {
              "const": "headers"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "header"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "header": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string"
                  },
                  "sensitive": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            },
            "instructions": {
              "type": "string"
            },
            "setup_url": {
              "type": "string",
              "format": "uri",
              "description": "The page where the user creates this credential, opened by a button in the install dialog. Query parameters that prefill the form are welcome."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "registration"],
          "properties": {
            "type": {
              "const": "oauth2"
            },
            "registration": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["preregistered", "cimd", "dcr", "user_supplied"]
              },
              "description": "Priority order to try (docs/plan/03 \u00a77)."
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "client": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "client_id": {
                  "type": "string"
                }
              }
            },
            "user_supplied_fields": {
              "type": "array",
              "items": {
                "enum": ["client_id", "client_secret"]
              }
            },
            "instructions": {
              "type": "string"
            },
            "setup_url": {
              "type": "string",
              "format": "uri",
              "description": "The page where the user creates this credential, opened by a button in the install dialog. Query parameters that prefill the form are welcome."
            }
          }
        }
      ]
    },
    "inject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "name"],
      "properties": {
        "in": {
          "enum": ["env", "header", "query"]
        },
        "name": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "description": "e.g. \"Bearer {value}\""
        }
      }
    },
    "userConfigField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title"],
      "properties": {
        "type": {
          "enum": ["string", "number", "boolean", "directory", "file", "select"]
        },
        "options": {
          "type": "array",
          "description": "What a `select` chooses between. A native connector whose options are live data \u2014 the models this machine can reach \u2014 leaves this out and fills them in when the form is asked for.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "default": {},
        "multiple": {
          "type": "boolean",
          "default": false
        },
        "sensitive": {
          "type": "boolean",
          "default": false
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "local_system", "default_tool_tier"],
      "properties": {
        "network": {
          "enum": ["none", "local", "internet"]
        },
        "local_system": {
          "enum": ["none", "read", "write", "execute"]
        },
        "default_tool_tier": {
          "$ref": "#/$defs/tier"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema", "risk"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "description": {
          "type": "string"
        },
        "input_schema": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "risk": {
          "$ref": "#/$defs/tier"
        },
        "always_confirm": {
          "type": "boolean"
        },
        "parallel_safe": {
          "type": "boolean"
        },
        "plan_mode": {
          "enum": ["allow", "deny", "classify"]
        },
        "stream_args": {
          "type": "boolean"
        }
      }
    }
  }
}

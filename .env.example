# Copy to .env and adjust. All settings use the GANTRY_ prefix.
GANTRY_ENV=dev
GANTRY_DATABASE_URL=postgresql+asyncpg://gantry:gantry@localhost:5432/gantry
GANTRY_LOG_LEVEL=INFO
GANTRY_LOG_FORMAT=console

# Secrets vault (run.sh generates this automatically — 32 bytes, hex).
# Losing it makes stored API keys/tokens unrecoverable.
# GANTRY_VAULT_KEY=<64 hex chars>

# Supabase auth. When set, every API route and WebSocket requires a valid
# Supabase JWT; when unset, auth is disabled (local dev / CI).
# GANTRY_SUPABASE_URL=https://<project-ref>.supabase.co
# GANTRY_ALLOWED_EMAILS=["you@example.com"]

# Fallback GitHub token for workers when no OAuth token is stored in the vault.
# GANTRY_GITHUB_TOKEN=ghp_...

# Copy to .env and adjust. All settings use the GANTRY_ prefix.
GANTRY_ENV=dev
GANTRY_DATABASE_URL=postgresql+asyncpg://gantry:gantry@localhost:5432/gantry
GANTRY_LOG_LEVEL=INFO
GANTRY_LOG_FORMAT=console

# Secrets vault (run.sh generates this automatically — 32 bytes, hex).
# Losing it makes stored API keys/tokens unrecoverable.
# GANTRY_VAULT_KEY=<64 hex chars>

# Supabase auth. When set, every API route and WebSocket requires a valid
# Supabase JWT; when unset, auth is disabled (local dev / CI).
# GANTRY_SUPABASE_URL=https://<project-ref>.supabase.co
# GANTRY_ALLOWED_EMAILS=["you@example.com"]

# Fallback GitHub token for workers when no OAuth token is stored in the vault.
# GANTRY_GITHUB_TOKEN=ghp_...

# --- Agent shell sandbox --------------------------------------------------
# An agent's `bash` command is model-authored, i.e. untrusted. Gantry always
# scrubs the environment down to an allowlist (no vault key, no database URL,
# no provider keys reach the shell), applies the resource ceilings below, and
# runs each command in its own process group so a timeout kills the whole tree.
#
# Filesystem/network isolation BETWEEN tasks additionally needs a wrapper:
# same-uid processes can always read each other's files, so without this one
# task can read another's workspace. Configure it on any multi-tenant or
# high-fan-out deployment; the worker logs a warning at boot when it is unset.
# {workspace} and {home} are substituted per command.
# GANTRY_SANDBOX_WRAPPER=bwrap --unshare-all --share-net --die-with-parent --ro-bind /usr /usr --ro-bind /etc /etc --proc /proc --dev /dev --bind {workspace} {workspace} --bind {home} {home} --
#
# Per-command resource ceilings (0 disables a limit).
# GANTRY_SANDBOX_MEMORY_MB=2048       # RLIMIT_AS; raise for JVM/Go/ASAN builds
# GANTRY_SANDBOX_FILE_SIZE_MB=2048    # RLIMIT_FSIZE; stops one file filling the disk
# GANTRY_SANDBOX_OPEN_FILES=4096      # RLIMIT_NOFILE
# GANTRY_SANDBOX_MAX_PROCESSES=0      # RLIMIT_NPROC; per-UID, so only useful when
#                                     # each worker runs as its own user
# Extra env names agent shells may inherit. Toolchain paths only — never secrets.
# GANTRY_SANDBOX_ENV_PASSTHROUGH=["CI"]

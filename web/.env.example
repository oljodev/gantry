# Copy to web/.env.local (dev) — and set for `npm run build` in production.
# Both unset => login is disabled and the app talks to the backend directly
# (matching the backend, which only enforces JWTs when GANTRY_SUPABASE_URL is set).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# Copy to web/.env.local (dev) — and set these in Cloudflare Pages → Settings →
# Environment variables for the production build.

# Where the Gantry API lives. Leave BLANK for same-origin (local dev proxy, or
# FastAPI serving the built SPA). On a split deploy (frontend on Cloudflare
# Pages, backend elsewhere / behind a Cloudflare Tunnel), set it to the backend
# origin. WebSockets follow this host automatically.
VITE_API_BASE=

# Supabase GitHub login. Both unset => login disabled and the app talks to the
# backend directly (matching the backend, which only enforces JWTs when
# GANTRY_SUPABASE_URL is set). Use the project URL — NOT the /auth/v1/callback
# URL — and the publishable (anon) key from Project Settings → API Keys.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# Paddle Billing (Merchant of Record) inline Overlay Checkout. All three unset
# => the "Buy credits" button doesn't render — the safe default until a real
# Paddle account exists. VITE_PADDLE_CLIENT_TOKEN is the CLIENT-SIDE token from
# Paddle Dashboard -> Developer tools -> Authentication (safe to expose in the
# built bundle — it is not a secret). VITE_PADDLE_DEFAULT_PRICE_ID is the
# price (pri_...) the button opens checkout for. VITE_PADDLE_ENVIRONMENT=sandbox
# targets Paddle's sandbox; leave unset (or "production") for live payments.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_DEFAULT_PRICE_ID=
VITE_PADDLE_ENVIRONMENT=sandbox

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { longDate } from '@/lib/dates';
import { REPO_URL } from '@/lib/seo';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog" description="Notes from building Gantry: design decisions, what shipped and why, and the occasional detour.">
  <section class="head">
    <div class="wrap-narrow">
      <p class="eyebrow">Blog</p>
      <h1 class="display">Notes from the build.</h1>
      <p class="lede">Design decisions, what shipped and why, and the occasional detour. Also available as <a class="link" href="/blog/rss.xml">RSS</a>.</p>
    </div>
  </section>
  <section class="wrap-narrow list">
    {posts.length === 0 ? (
      <div class="empty card" data-reveal>
        <p class="eyebrow">Nothing here yet</p>
        <h2 class="title-sm">The first post is being written.</h2>
        <p class="prose-muted">Until then the plan documents in the repository are the long read, and the changelog will carry the short one once releases start.</p>
        <div class="empty-links"><a class="btn" href={REPO_URL} rel="noopener">The repository</a><a class="btn" href="/changelog/">Changelog</a></div>
      </div>
    ) : (
      <ol class="posts">
        {posts.map((p) => (
          <li data-reveal>
            <a class="post" href={`/blog/${p.id}/`}>
              <time class="post-date" datetime={p.data.pubDate.toISOString()}>{longDate(p.data.pubDate)}</time>
              <span class="post-title">{p.data.title}</span>
              <span class="post-desc">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>
<style>
  .head { padding: clamp(3.5rem, 8vw, 6rem) 0 2rem; }
  .head .display { margin-top: 1rem; }
  .head .lede { margin-top: 1.25rem; }
  .list { padding-bottom: clamp(4rem, 8vw, 6rem); }
  .empty { display: grid; gap: 0.8rem; padding: 2rem; justify-items: start; }
  .empty-links { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .posts { list-style: none; margin: 0; padding: 0; }
  .post { display: grid; gap: 0.3rem; padding: 1.5rem 0; border-top: 1px solid var(--color-line); }
  .post-date { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-fg-3); }
  .post-title { font-size: 1.35rem; font-weight: 600; color: var(--color-fg); letter-spacing: -0.01em; }
  .post:hover .post-title { color: var(--color-brand); }
  .post-desc { color: var(--color-fg-2); }
</style>

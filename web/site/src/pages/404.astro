---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex>
  <section class="section">
    <div class="wrap-narrow">
      <p class="eyebrow">404</p>
      <h1 class="title mt-3">There is nothing at this address.</h1>
      <p class="lede mt-4">The page may have moved when the site was reorganised. The links below go somewhere.</p>
      <p class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="/">Home</a><a class="btn" href="/docs/">Docs</a><a class="btn" href="/connectors/">Connectors</a></p>
    </div>
  </section>
</BaseLayout>

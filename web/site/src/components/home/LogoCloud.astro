---
/** The connectors, Ramp-style: a bordered card of small logo tiles that light up in waves travelling across the
 *  grid. Pure CSS: each tile carries two build-time phases (desktop and phone column counts) and shares one keyframe.
 *  The whole card is one link; the grid is decorative for assistive tech. Reduced motion shows the lit grid. */
import { connectors } from '@/data/connectors';
import Mark from '@/components/connectors/Mark.astro';

const COLS = { lg: 9, sm: 6 };
const extras = [{ label: 'Any MCP server', text: 'MCP' }, { label: 'More coming', text: '+' }];
const total = connectors.length + extras.length;
const phase = (i: number, cols: number) => {
  const rows = Math.ceil(total / cols);
  const r = Math.floor(i / cols), c = i % cols;
  return ((r + c) / (rows - 1 + cols - 1)).toFixed(3);
};
---
<a class="cloud card" href="/connectors/" aria-label={`Browse all ${connectors.length} connectors`}>
  <div class="cloud-head">
    <span class="cloud-title">{connectors.length} connectors, one permission model</span>
    <span class="arrow-link">Browse the directory</span>
  </div>
  <ul class="cloud-grid" aria-hidden="true">
    {connectors.map((c, i) => (
      <li class="tile" title={c.name} style={`--p-lg:${phase(i, COLS.lg)};--p-sm:${phase(i, COLS.sm)}`}><Mark connector={c} size={22} /></li>
    ))}
    {extras.map((e, j) => (
      <li class="tile tile-text" title={e.label} style={`--p-lg:${phase(connectors.length + j, COLS.lg)};--p-sm:${phase(connectors.length + j, COLS.sm)}`}>{e.text}</li>
    ))}
  </ul>
</a>
<style>
  .cloud { display: block; padding: 1.25rem 1.25rem 1.35rem; transition: border-color 150ms ease; }
  .cloud:hover { border-color: var(--color-line-2); }
  .cloud-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.1rem; }
  .cloud-title { font-weight: 500; color: var(--color-fg); }
  .cloud-grid { --cols: 6; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 0.5rem; }
  .tile { --p: var(--p-sm); aspect-ratio: 1; display: grid; place-items: center; border-radius: 0.65rem; border: 1px solid var(--color-line); background: var(--color-bg); opacity: 0.4; filter: saturate(0.2); }
  .tile-text { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-fg-2); }
  @media (min-width: 52rem) { .cloud-grid { --cols: 9; } .tile { --p: var(--p-lg); } }
  @keyframes tile-wave {
    0%, 100% { opacity: 0.4; filter: saturate(0.2); border-color: var(--color-line); box-shadow: none; }
    10% { opacity: 1; filter: saturate(1); border-color: color-mix(in oklab, var(--color-brand) 45%, var(--color-line)); box-shadow: 0 0 18px -6px var(--color-brand); }
    26% { opacity: 0.4; filter: saturate(0.2); border-color: var(--color-line); box-shadow: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tile { animation: tile-wave 7s ease-in-out infinite; animation-delay: calc(var(--p) * 2.4s); }
    .cloud:hover .tile, .cloud:focus-visible .tile { animation-play-state: paused; }
    .tile:hover { animation: none; opacity: 1; filter: none; border-color: var(--color-line-2); }
  }
  @media (prefers-reduced-motion: reduce) { .tile { opacity: 1; filter: none; } }
  @media (max-width: 40rem) { .cloud-head { flex-direction: column; align-items: flex-start; gap: 0.3rem; } }
</style>

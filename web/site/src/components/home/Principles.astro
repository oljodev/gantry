---
/** Three principles, Linear-style, with a line drawing each. Geometry only: isometric boxes, a key, a plug. */
const items = [
  { fig: '0.1', title: 'Keys stay in your keychain', text: 'API keys and tokens are encrypted with a key that lives in your OS keychain, Credential Manager or Secret Service. They never reach the interface layer, and they never reach us.' },
  { fig: '0.2', title: 'Your data is a file you own', text: 'Chats, projects, memory and artifacts live in a SQLite database and a folder on your disk. Full-text search included. Copy it, back it up, delete it.' },
  { fig: '0.3', title: 'Nothing installs itself', text: 'The connector catalog ships with the app, and every connector waits for an explicit Install. The agent can suggest one; only you can add it.' },
];
---
<section class="section principles" aria-labelledby="principles-title">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="eyebrow">Local by construction</p>
      <h2 id="principles-title" class="title">No account, no server, no telemetry. <span class="dim">The app talks to the providers and services you configure, and to nothing else.</span></h2>
    </div>
    <ol class="cols">
      {items.map((it, i) => (
        <li class="col" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <p class="fig-label">FIG {it.fig}</p>
          <div class="art" aria-hidden="true">
            {i === 0 && (
              <svg viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round">
                <path d="M120 40 L190 75 L120 110 L50 75 Z" /><path d="M50 75 V135 L120 170 L190 135 V75" /><path d="M120 110 V170" />
                <path d="M50 95 L120 130 L190 95" opacity=".5" /><path d="M50 115 L120 150 L190 115" opacity=".35" />
                <circle cx="120" cy="82" r="8" /><path d="M120 90 V101" /><path d="M120 94 H126" /><path d="M120 98 H125" />
              </svg>
            )}
            {i === 1 && (
              <svg viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round">
                <path d="M70 30 H150 L180 60 V170 H70 Z" /><path d="M150 30 V60 H180" />
                <ellipse cx="125" cy="90" rx="34" ry="10" /><path d="M91 90 V128" /><path d="M159 90 V128" /><path d="M91 128 A34 10 0 0 0 159 128" />
                <path d="M91 109 A34 10 0 0 0 159 109" opacity=".5" />
                <path d="M86 148 H164" opacity=".5" /><path d="M86 156 H140" opacity=".35" />
              </svg>
            )}
            {i === 2 && (
              <svg viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round">
                <path d="M40 100 H92" /><rect x="92" y="82" width="30" height="36" rx="6" /><path d="M122 92 H138" /><path d="M122 108 H138" />
                <rect x="160" y="70" width="44" height="60" rx="8" /><path d="M170 92 H180" /><path d="M170 108 H180" /><path d="M204 100 H220" />
                <path d="M141 62 L153 74" opacity=".5" /><path d="M141 138 L153 126" opacity=".5" />
                <circle cx="182" cy="150" r="10" /><path d="M182 160 V178" /><path d="M172 170 H192" opacity=".6" />
              </svg>
            )}
          </div>
          <h3 class="title-sm">{it.title}</h3>
          <p class="prose-muted">{it.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .head { max-width: 46rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .head .title { margin-top: 0.9rem; }
  .cols { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .col { padding: 0 2rem 2rem 0; display: grid; gap: 0.9rem; align-content: start; }
  .col + .col { border-left: 1px solid var(--color-line); padding-left: 2rem; }
  .fig-label { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; color: var(--color-fg-3); }
  .art { color: var(--color-fg-3); max-width: 18rem; margin-block: 0.5rem 1rem; }
  .art svg { width: 100%; height: auto; display: block; }
  .col h3 { font-size: 1.15rem; }
  .col p.prose-muted { font-size: 0.97rem; }
  @media (max-width: 52rem) { .cols { grid-template-columns: 1fr; gap: 2rem; } .col + .col { border-left: 0; padding-left: 0; border-top: 1px solid var(--color-line); padding-top: 2rem; } .col { padding-right: 0; } }
</style>

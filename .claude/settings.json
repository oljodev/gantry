{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/pull.sh\"",
            "timeout": 30,
            "statusMessage": "Pulling latest from GitHub"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/push.sh\"",
            "timeout": 30,
            "statusMessage": "Pushing to GitHub"
          }
        ]
      }
    ]
  }
}
